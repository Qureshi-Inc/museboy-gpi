#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo "Run through sudo." >&2; exit 1; }
[ -s /var/lib/musegadget/sdk_token ] || {
    echo "Enter a personal SDK token in Settings first." >&2
    exit 2
}
systemd-run --quiet --collect --unit=gpi-muse-pair /usr/local/bin/musegadget pair
echo "BLE pairing opened. In Muse, choose Settings > Devices > Add Device."
